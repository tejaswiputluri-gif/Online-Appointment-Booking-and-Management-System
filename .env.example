# Application
APP_NAME=Appointment Booking System
APP_ENV=development
DEBUG=true

# PostgreSQL
# - API on your machine (uvicorn locally): use localhost
# - API inside Docker Compose: use hostname "postgres" (see docker-compose.yml)
DATABASE_URL=postgresql://booking_user:booking_pass@localhost:5432/appointment_db

# Redis
# - Local uvicorn: localhost
# - Inside Docker Compose: hostname "redis"
REDIS_URL=redis://localhost:6379/0

# JWT — generate a strong secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Distributed lock TTL (seconds) — short enough to recover from crashes,
# long enough to cover a typical DB transaction under load.
REDIS_LOCK_TTL_SECONDS=10

# Rate limiting on POST /appointments/book
BOOKING_RATE_LIMIT_PER_MINUTE=5

# APScheduler reminder job interval (minutes)
REMINDER_JOB_INTERVAL_MINUTES=15
# How far ahead to look for upcoming appointments
REMINDER_LOOKAHEAD_HOURS=24

# CORS (comma-separated origins; use * only in local demo)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
